# Copy to .env and adjust. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
POSTGRES_DB=srerp
POSTGRES_USER=srerp
POSTGRES_PASSWORD=srerp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Static ---------------------------------------------------------------
# Defaults to /tmp/static: the production container runs a read-only root
# filesystem, and collectstatic must still have somewhere to write.
DJANGO_STATIC_ROOT=/tmp/static

# --- Audit partitions (D10) ----------------------------------------------
# How many quarters ahead `manage.py ensure_audit_partitions` keeps open.
AUDIT_PARTITION_QUARTERS_AHEAD=8

# --- Login throttling -----------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Object storage (Phase 3, D9) ----------------------------------------
# Development uses MinIO from compose.yaml. Production is undecided.
STORAGE_BACKEND=filesystem
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=srerp-documents
AWS_S3_REGION_NAME=us-east-1
