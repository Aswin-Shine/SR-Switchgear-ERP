# Root .env for the production docker-compose.yml (repo root). Copy to .env
# and fill in real values — never commit .env.
#
# This is distinct from backend/.env.example, which is for running the
# backend directly (venv, no Docker) against a locally installed PostgreSQL.
# See LOCAL_DEPLOYMENT.md for that path.

# --- Django -------------------------------------------------------------
# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated. Must include every hostname the app is reached by.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme included (e.g. https://erp.example.com). Required
# by Django whenever a form is posted over HTTPS from one of these origins.
DJANGO_CSRF_TRUSTED_ORIGINS=

# production.py redirects http->https by default (SECURE_SSL_REDIRECT=True)
# and assumes a reverse proxy in front sets X-Forwarded-Proto. Set this to 0
# only if you are deliberately testing the stack over plain HTTP with no
# proxy in front of it.
DJANGO_SECURE_SSL_REDIRECT=1

# --- Database -------------------------------------------------------------
POSTGRES_DB=srerp
POSTGRES_USER=srerp
# Required — no default in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Audit partitions (D10, see backend/IMPLEMENTATION.md) ----------------
AUDIT_PARTITION_QUARTERS_AHEAD=8

# --- Login throttling -------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Object storage (Phase 3, D9) -------------------------------------------
# "filesystem" writes to the `media_data` volume (docker-compose.yml mounts
# it at /srv/app/media, MEDIA_ROOT) — works out of the box, no setup needed,
# which is why it's the default here. Switch to "s3" for real AWS S3 or any
# S3-compatible endpoint (MinIO included — see the `minio` profile in
# docker-compose.yml) and fill in the AWS_* values below; leaving them
# blank with STORAGE_BACKEND=s3 makes uploads fail outright, it does not
# fall back to filesystem.
STORAGE_BACKEND=filesystem
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=srerp-documents
AWS_S3_REGION_NAME=us-east-1

# --- Only used when running docker-compose.yml with `--profile minio` -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# --- Caddy reverse proxy (`docker compose --profile caddy up`, off by default,
# see Caddyfile) ------------------------------------------------------------
# Defaults below (localhost / internal) are for local dev only — Caddy uses
# its own local CA, no internet/DNS needed, browsers show a trust warning
# (expected; `caddy trust` on your machine silences it). For a real
# deployment host, replace BOTH with your real domain and a real email —
# CADDY_TLS_ARG then switches Caddy from its local CA to ACME/Let's
# Encrypt, which needs CADDY_SITE_ADDRESS to actually resolve to this host
# with 80/443 reachable from the internet.
CADDY_SITE_ADDRESS=localhost
CADDY_TLS_ARG=internal

# CADDY_BASIC_AUTH_PASSWORD is only ever read by docker-compose.caddy.yaml,
# to produce the bcrypt hash below — it is never read by Caddy itself and
# never sent anywhere. Run this first, once, whenever you set or change it:
#   docker compose -f docker-compose.caddy.yaml run --rm hash-password
# then paste the printed $2a$... hash into CADDY_BASIC_AUTH_HASH — but
# DOUBLE every `$` to `$$` first (bcrypt hashes are full of them, and
# Compose treats a bare `$` in .env as the start of its own ${...}
# interpolation; a single-`$` hash gets silently mangled to blank/wrong,
# breaking basic_auth). Example: $2a$14$abc... -> $$2a$$14$$abc...
CADDY_BASIC_AUTH_USERNAME=srsadmin
CADDY_BASIC_AUTH_PASSWORD=
CADDY_BASIC_AUTH_HASH=
