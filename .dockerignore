# Build context is the repo root (see backend/Dockerfile's header comment).
# Docker resolves .dockerignore relative to the context, so this file lives
# here now instead of backend/.dockerignore.

.git
**/.gitignore

# --- backend ----------------------------------------------------------------
backend/.venv
backend/venv
backend/**/__pycache__
backend/**/*.py[cod]
backend/.env
backend/.pytest_cache
backend/.ruff_cache
backend/.mypy_cache
backend/.coverage
backend/htmlcov
backend/tests
backend/docs
backend/compose.yaml
backend/**/*.dump

# --- frontend -----------------------------------------------------------
frontend/node_modules
frontend/dist
frontend/.vite
frontend/playwright-report
frontend/test-results
frontend/tests
frontend/*.local
frontend/.env

# --- repo docs (not needed inside the image) --------------------------------
*.md
docker-compose.yml
LOCAL_DEPLOYMENT.md
